# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application
APP_NAME="Google ADK Multi-Agent HR Platform"
API_V1_STR="/api/v1"
SECRET_KEY="dev_super_secret_jwt_key_at_least_32_characters_long"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL + pgvector)
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=hr_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hr_db
DATABASE_URL=postgresql+asyncpg://hr_user:hr_password@localhost:5432/hr_db
SYNC_DATABASE_URL=postgresql://hr_user:hr_password@localhost:5432/hr_db

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=hr_neo4j_password

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secret_password
S3_BUCKET_NAME=hr-documents
S3_SECURE=false

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"
MOCK_SSO_ENABLED=true

# LLM & Vertex AI
VERTEX_PROJECT_ID="your-gcp-project-id"
VERTEX_LOCATION="us-central1"
GEMINI_MODEL="gemini-3.8-flash"
MOCK_LLM_ENABLED=true

# Webhook shared secrets (required in production; generate with `openssl rand -hex 32`)
LANGFUSE_WEBHOOK_SECRET=""
ZOHO_WEBHOOK_SECRET=""

# docker-compose credentials (required by docker-compose.yml)
POSTGRES_PASSWORD=hr_password
NEO4J_PASSWORD=hr_neo4j_password

# NVIDIA NeMo Guardrails
NEMO_GUARDRAILS_CONFIG_DIR="app/guardrails/config"

# Langfuse tracing (keys optional; tracing is always off when ENVIRONMENT=testing)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
LANGFUSE_ENABLED=true
LANGFUSE_WEBHOOK_TOLERANCE_SECONDS=600   # max age of a signed Langfuse webhook; 0 disables
PROMPT_WATCH_INTERVAL_SECONDS=30       # safety-net poll for prompt changes (the webhook is the fast path)
LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_RELEASE=          # defaults to APP_VERSION

# ADK conversation sessions. Empty = in-memory (lost on restart). Set a SYNC SQLAlchemy URL to persist.
ADK_SESSION_DB_URL=

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="hr-multiagent-platform"
