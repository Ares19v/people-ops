# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application
APP_NAME="Google ADK Multi-Agent HR Platform"
API_V1_STR="/api/v1"
SECRET_KEY="dev_super_secret_jwt_key_at_least_32_characters_long"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL + pgvector)
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=hr_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hr_db
DATABASE_URL=postgresql+asyncpg://hr_user:hr_password@localhost:5432/hr_db
SYNC_DATABASE_URL=postgresql://hr_user:hr_password@localhost:5432/hr_db

# Pinecone (policy RAG, integrated inference). Leave the key empty to use the local keyword fallback.
# Run `python scripts/index_pinecone.py` once to create the index and upload the policy corpus.
PINECONE_API_KEY=
PINECONE_INDEX=people-ops-policies
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secret_password
S3_BUCKET_NAME=hr-documents
S3_SECURE=false

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"
MOCK_SSO_ENABLED=true

# LLM & Vertex AI
VERTEX_PROJECT_ID="your-gcp-project-id"
VERTEX_LOCATION="us-central1"
GEMINI_MODEL="gemini-3.8-flash"
MOCK_LLM_ENABLED=true

# Webhook shared secrets (required in production; generate with `openssl rand -hex 32`)
LANGFUSE_WEBHOOK_SECRET=""
ZOHO_WEBHOOK_SECRET=""

# docker-compose credentials (required by .extras/docker/docker-compose.yml)
POSTGRES_PASSWORD=hr_password

# NVIDIA NeMo Guardrails
NEMO_GUARDRAILS_CONFIG_DIR="app/guardrails/config"

# Langfuse tracing (keys optional; tracing is always off when ENVIRONMENT=testing)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
LANGFUSE_ENABLED=true
LANGFUSE_WEBHOOK_TOLERANCE_SECONDS=600   # max age of a signed Langfuse webhook; 0 disables
PROMPT_WATCH_INTERVAL_SECONDS=30       # safety-net poll for prompt changes (the webhook is the fast path)
LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_RELEASE=          # defaults to APP_VERSION

# ADK conversation sessions. Empty = in-memory (lost on restart). Set a SQLAlchemy URL to persist
# (a plain postgresql:// or sqlite:/// URL is converted to its async driver, which ADK 2.x requires).
ADK_SESSION_DB_URL=

# Retry rate-limited LLM calls (e.g. Groq free tier). The ADK / evaluation scripts default this to 5; the API keeps 0.
# LLM_NUM_RETRIES=0

# Google ADK Web (npm run adk:web). It always uses an isolated SQLite file, never DATABASE_URL.
# ADK_WEB_MODEL=openai/gpt-4o-mini     # model for the ADK Web agents (default: the backend's provider)
# ADK_WEB_DB_FILE=backend/data/adk_web.db

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="hr-multiagent-platform"
