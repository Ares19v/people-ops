{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cmd /c \"cd /d ..\\backend && set PYTHONPATH=. && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 38290 --reload\"",
    "adk:web": "cmd /c \"cd /d ..\\backend && set PYTHONPATH=. && .venv\\Scripts\\python.exe ..\\scripts\\run_adk_web.py\"",
    "adk:grid": "cmd /c \"cd /d ..\\backend && set PYTHONPATH=. && .venv\\Scripts\\python.exe ..\\scripts\\run_adk_grid.py\"",
    "adk:compare": "cmd /c \"cd /d ..\\backend && set PYTHONPATH=. && .venv\\Scripts\\python.exe ..\\scripts\\run_adk_prompt_compare.py\"",
    "optimize:prompt": "cmd /c \"cd /d ..\\backend && set PYTHONPATH=. && .venv\\Scripts\\python.exe ..\\scripts\\run_prompt_optimization.py\"",
    "dev:ngrok": "ngrok http --domain=upcountry-scarcity-hatchery.ngrok-free.dev 38290",
    "dev:all": "node ../scripts/banner.js && npm run dev:all:fleet",
    "dev:all:fleet": "concurrently -k -n \"backend,frontend,ngrok\" -c \"blue.bold,green.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev\" \"npm run dev:ngrok\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
